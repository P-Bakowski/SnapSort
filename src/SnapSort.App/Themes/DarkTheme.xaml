<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="ShadowColor">#66000000</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#0F2743" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#09111F" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0B1322" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#0D1626" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#111B2D" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B1423" />
    <SolidColorBrush x:Key="CardBrush" Color="#151F31" />
    <SolidColorBrush x:Key="ControlBrush" Color="#141E30" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#1B273B" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#223149" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6FB" />
    <SolidColorBrush x:Key="MutedBrush" Color="#AAB5C7" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#738097" />
    <SolidColorBrush x:Key="LineBrush" Color="#202C40" />
    <SolidColorBrush x:Key="StrongLineBrush" Color="#344258" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#263448" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8391A5" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#18345F" />
    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#151F30" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#C2080D16" />
    <SolidColorBrush x:Key="FolderBrush" Color="#FBBF24" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
</ResourceDictionary>
