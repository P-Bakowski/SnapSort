<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#3988FF</Color>
    <Color x:Key="ShadowColor">#66000000</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2875E8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#20324B" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#17191D" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#202226" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#17191D" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#202226" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#1D1F23" />
    <SolidColorBrush x:Key="CardBrush" Color="#25282D" />
    <SolidColorBrush x:Key="ControlBrush" Color="#292C31" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#32363D" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#3B4048" />
    <SolidColorBrush x:Key="TextBrush" Color="#F0F1F3" />
    <SolidColorBrush x:Key="MutedBrush" Color="#ADB2BB" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#969DA8" />
    <SolidColorBrush x:Key="LineBrush" Color="#303339" />
    <SolidColorBrush x:Key="StrongLineBrush" Color="#555C68" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#25282D" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#737B89" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#294367" />
    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#23262B" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#C2080D16" />
    <SolidColorBrush x:Key="FolderBrush" Color="#D7B76A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
</ResourceDictionary>
