<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="ShadowColor">#260F172A</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FF" />
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E7ECF3" />
    <SolidColorBrush x:Key="TextBrush" Color="#242830" />
    <SolidColorBrush x:Key="MutedBrush" Color="#606975" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#737D8B" />
    <SolidColorBrush x:Key="LineBrush" Color="#E1E4E9" />
    <SolidColorBrush x:Key="StrongLineBrush" Color="#A5AFBD" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#E7EAF0" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#8A96A7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#DCE9FF" />
    <SolidColorBrush x:Key="TilePlaceholderBrush" Color="#EEF2F7" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#B0182433" />
    <SolidColorBrush x:Key="FolderBrush" Color="#A98125" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
</ResourceDictionary>
