<Window x:Class="SnapSort.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="SnapSort" Icon="Assets/Branding/SnapSort.ico" Width="1100" Height="760" MinWidth="720" MinHeight="520"
        Background="{DynamicResource AppBackgroundBrush}" WindowStartupLocation="CenterOwner"
        Style="{StaticResource DialogWindowStyle}">
    <Grid TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="68" /></Grid.RowDefinitions>

        <Image x:Name="FullImage" Stretch="Uniform" Margin="20">
            <Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Image.Style>
        </Image>
        <vlc:VideoView x:Name="VideoView" Margin="20" />

        <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" ToolTip="Odtwórz" Click="PlayVideo">&#xE768;</Button>
                    <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" ToolTip="Pauza" Click="PauseVideo">&#xE769;</Button>
                </StackPanel>
                <Slider x:Name="Timeline" Grid.Column="1" Minimum="0" Maximum="1" Margin="18,0" VerticalAlignment="Center"
                        PreviewMouseLeftButtonDown="SeekVideo" />
                <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="00:00 / 00:00" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Background="{DynamicResource OverlayBrush}" CornerRadius="6" Padding="10,6"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24">
            <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</Window>
