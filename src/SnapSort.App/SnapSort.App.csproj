<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SnapSort</AssemblyName>
    <AssemblyTitle>SnapSort</AssemblyTitle>
    <Product>SnapSort</Product>
    <Description>SnapSort - inteligentne porządkowanie zdjęć</Description>
    <ApplicationIcon>Assets\Branding\SnapSort.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Branding\*" />
    <None Include="..\..\python\PhotoAnalysis.Worker\dist\PhotoAnalysis.Worker\**\*" Link="python\PhotoAnalysis.Worker\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\python\PhotoAnalysis.Worker\dist\PhotoAnalysis.Worker\PhotoAnalysis.Worker.exe')" />
  </ItemGroup>
</Project>
