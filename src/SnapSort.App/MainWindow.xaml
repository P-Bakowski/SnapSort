<Window x:Class="SnapSort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnapSort.App"
        xmlns:models="clr-namespace:SnapSort.App.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SnapSort" Icon="Assets/Branding/SnapSort.ico" Width="1500" Height="900" MinWidth="1120" MinHeight="720"
        local:WindowCommands.FitToWorkArea="True"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}" Style="{StaticResource {x:Type Window}}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome" CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="ThumbnailGridPanel"><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}" ItemsSource="{Binding Children}">
            <Border CornerRadius="5" Padding="7,7" Margin="0,1,2,1" BorderThickness="2,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE838;" Style="{StaticResource UiIcon}" Foreground="{DynamicResource FolderBrush}"
                               HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </Grid>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid>
            <Grid.InputBindings>
                <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
                <KeyBinding Key="Delete" Command="{Binding MoveSelectedToTrashCommand}" />
            </Grid.InputBindings>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="308" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <Grid Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="36" Height="36" Source="Assets/Branding/SnapSort_logo.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Snap" FontWeight="Bold" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sort" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                   FontSize="20" VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Column="1" MaxWidth="470" Margin="24,0,32,0" Height="34" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBox Height="34" MinHeight="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,6,12,6"
                                 VerticalContentAlignment="Center" AutomationProperties.Name="Szukaj w folderze" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}"
                                   Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock Text="Szukaj w folderze..." Foreground="{DynamicResource SubtleTextBrush}"
                                   Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource WindowButton}" ToolTip="O aplikacji" Click="OpenAbout">
                            <TextBlock Text="&#xE946;" Style="{StaticResource UiIcon}" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Przełącz motyw" Click="ToggleTheme"><TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" /></Button>
                        <Border Width="1" Height="22" Background="{DynamicResource LineBrush}" VerticalAlignment="Center" Margin="2,0,4,0" />
                        <Button Style="{StaticResource WindowButton}" ToolTip="Minimalizuj" Click="MinimizeWindow"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" /></Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Maksymalizuj" Click="MaximizeWindow">
                            <TextBlock FontFamily="Segoe MDL2 Assets">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE922;" />
                                    <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Text" Value="&#xE923;" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Zamknij" Click="CloseWindow"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" /></Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding KeepSelectedCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE739;" Style="{StaticResource UiIcon}" Margin="0,0,8,0" /><TextBlock Text="Odznacz" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Command="{Binding SelectAllCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73A;" Style="{StaticResource UiIcon}" Margin="0,0,8,0" /><TextBlock Text="Zaznacz wszystkie" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Command="{Binding MoveSelectedToTrashCommand}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource UiIcon}" Margin="0,0,8,0" /><TextBlock Text="Przenieś do kosza" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarButton}" Margin="8,0,0,0" Click="OpenCompare">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE89A;" Style="{StaticResource UiIcon}" Margin="0,0,8,0" /><TextBlock Text="Porównaj" /></StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Command="{Binding RotateSelectedCommand}" ToolTip="Obróć zaznaczone">
                            <TextBlock Text="&#xE7AD;" Style="{StaticResource UiIcon}" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="8,0,0,0" Command="{Binding UndoCommand}" ToolTip="Cofnij">&#xE7A7;</Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Width="210" SelectedIndex="0" SelectionChanged="SortSelectionChanged" AutomationProperties.Name="Sortowanie">
                            <ComboBoxItem Content="Sortuj: Data wykonania" />
                            <ComboBoxItem Content="Sortuj: Nazwa" />
                            <ComboBoxItem Content="Sortuj: Rozmiar" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Folder sidebar -->
            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="14,8,10,14">
                    <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="Foldery lokalne" Style="{StaticResource PanelHeaderText}" VerticalAlignment="Center" />
                    </Grid>
                    <TreeView Grid.Row="1" ItemsSource="{Binding Folders}" SelectedItemChanged="FolderSelected"
                              TreeViewItem.Expanded="FolderExpanded" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>

            <!-- Gallery -->
            <Grid Grid.Row="2" Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="66" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="‹  Podobne zdjęcia" Style="{StaticResource ToolbarButton}" MinHeight="32" Padding="10,4" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSimilarityGroupOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Click="CloseSimilarityGroup" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentCollection}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentFolder}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentFolder}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Photos.Count, StringFormat={}{0} elementów}" Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="12,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <ListBox x:Name="PhotoList" Grid.Row="1" ItemsSource="{Binding PhotoView}" SelectedItem="{Binding ActivePhoto}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="False"
                         Padding="12,0,8,14">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions><Condition Binding="{Binding CurrentCollection}" Value="Podobne zdjęcia" /><Condition Binding="{Binding ActiveSimilarityGroup}" Value="{x:Null}" /></MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel><StaticResource ResourceKey="ThumbnailGridPanel" /></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TileChrome" Margin="6" CornerRadius="8" ClipToBounds="True"
                                    Background="{DynamicResource TilePlaceholderBrush}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    MouseEnter="PhotoMouseEnter" MouseLeave="PhotoMouseLeave" MouseLeftButtonDown="PhotoMouseLeftButtonDown">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Zaakceptuj prawidłowe położenie"
                                                  Command="{Binding PlacementTarget.Tag.AcceptOrientationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsSideways}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                        <MenuItem Header="Przenieś do kosza" Click="MovePhotoToTrash" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="Height" Value="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource StrongLineBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Border CornerRadius="6" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background><ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" /></Border.Background>
                                    </Border>
                                    <Border Background="{DynamicResource TilePlaceholderBrush}">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ProgressBar Width="74" IsIndeterminate="True" />
                                            <TextBlock Text="Ładowanie" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                                        </StackPanel>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Grid>
                                        <Grid Width="56" Height="56" ClipToBounds="True" IsHitTestVisible="False"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid.OpacityMask>
                                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                    <GradientStop Color="White" Offset="0" />
                                                    <GradientStop Color="White" Offset="0.92" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </RadialGradientBrush>
                                            </Grid.OpacityMask>
                                            <Image Source="{Binding Thumbnail}" Width="{Binding ActualWidth, ElementName=TileChrome}"
                                                   Height="{Binding ActualHeight, ElementName=TileChrome}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Effect><BlurEffect Radius="7" RenderingBias="Quality" /></Image.Effect>
                                            </Image>
                                        </Grid>
                                        <Button Width="56" Height="56" Padding="0" BorderThickness="0" Background="Transparent"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Odtwórz" Click="OpenVideo">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse x:Name="PlayCircle" Fill="#700B1424" Stroke="#168BFF" StrokeThickness="2">
                                                            <Ellipse.Effect><DropShadowEffect Color="#168BFF" BlurRadius="10" ShadowDepth="0" Opacity="0.48" /></Ellipse.Effect>
                                                        </Ellipse>
                                                        <Path Data="M0,0 L0,22 L18,11 Z" Width="18" Height="22" Stretch="Fill"
                                                              Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0">
                                                            <Path.Effect><DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.55" /></Path.Effect>
                                                        </Path>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PlayCircle" Property="Fill" Value="#900B1424" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Border Background="#B0081220" CornerRadius="4" Padding="6,3" Margin="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DurationLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers><DataTrigger Binding="{Binding DurationMilliseconds}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                    </Grid>
                                    <CheckBox Style="{StaticResource ThumbnailCheckBox}" IsChecked="{Binding IsSelected}" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Border Background="{DynamicResource OverlayBrush}" CornerRadius="5" Padding="7,4" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource WhiteBrush}" FontSize="12" />
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Badge}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    </Border>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                                        <Button Style="{StaticResource ThumbnailRotateButton}"
                                                Command="{Binding DataContext.RotateRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Obróć o 90° w prawo">
                                            <Ellipse Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Ellipse.Fill><ImageBrush ImageSource="Assets/Branding/RotatePhoto.png" Stretch="Uniform" /></Ellipse.Fill>
                                            </Ellipse>
                                        </Button>
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ListBox Grid.Row="1" ItemsSource="{Binding SimilarityGroups}" SelectedItem="{Binding ActiveSimilarityGroup}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                         ScrollViewer.CanContentScroll="False"
                         Padding="12,0,8,14">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions><Condition Binding="{Binding CurrentCollection}" Value="Podobne zdjęcia" /><Condition Binding="{Binding ActiveSimilarityGroup}" Value="{x:Null}" /></MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemsPanel><StaticResource ResourceKey="ThumbnailGridPanel" /></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="6" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    Background="{DynamicResource TilePlaceholderBrush}" Cursor="Hand">
                                <Grid>
                                    <Image Source="{Binding Photos[0].Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border Background="#B30B1424" VerticalAlignment="Bottom" Padding="10,8">
                                        <TextBlock Foreground="White" FontWeight="SemiBold"><Run Text="Grupa #" /><Run Text="{Binding Id}" /></TextBlock>
                                    </Border>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="8,4" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Photos.Count}" Foreground="White" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Smart collections and details -->
            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,20">
                        <Grid Margin="8,0,0,16">
                            <TextBlock Text="Inteligentne kolekcje" Style="{StaticResource PanelHeaderText}" />
                        </Grid>

                        <Button Command="{Binding ShowCollectionCommand}" CommandParameter="Wszystkie">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CollectionButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentCollection}" Value="Wszystkie"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8A9;" Style="{StaticResource UiIcon}" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Wszystkie" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource CountBadge}"><TextBlock Text="{Binding Photos.Count}" TextAlignment="Center" /></Border></Grid>
                        </Button>
                        <Button Command="{Binding ShowCollectionCommand}" CommandParameter="Podobne zdjęcia">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CollectionButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentCollection}" Value="Podobne zdjęcia"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE8C8;" Style="{StaticResource UiIcon}" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Podobne zdjęcia" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource CountBadge}"><TextBlock Text="{Binding SimilarPhotosCount}" TextAlignment="Center" /></Border></Grid>
                        </Button>
                        <Button Command="{Binding ShowCollectionCommand}" CommandParameter="Rozmazane">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CollectionButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentCollection}" Value="Rozmazane"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE81E;" Style="{StaticResource UiIcon}" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Rozmazane" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource CountBadge}"><TextBlock Text="{Binding BlurryCount}" TextAlignment="Center" /></Border></Grid>
                        </Button>
                        <Button Command="{Binding ShowCollectionCommand}" CommandParameter="Zdjęcia bokiem">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CollectionButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentCollection}" Value="Zdjęcia bokiem"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7AD;" Style="{StaticResource UiIcon}" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Zdjęcia bokiem" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource CountBadge}"><TextBlock Text="{Binding SidewaysCount}" TextAlignment="Center" /></Border></Grid>
                        </Button>
                        <Button Command="{Binding ShowCollectionCommand}" CommandParameter="Filmy">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CollectionButton}"><Style.Triggers><DataTrigger Binding="{Binding CurrentCollection}" Value="Filmy"><Setter Property="Tag" Value="True" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE714;" Style="{StaticResource UiIcon}" HorizontalAlignment="Left" /><TextBlock Grid.Column="1" Text="Filmy" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource CountBadge}"><TextBlock Text="{Binding VideosCount}" TextAlignment="Center" /></Border></Grid>
                        </Button>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers><DataTrigger Binding="{Binding ActiveSimilarityGroup}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"><Run Text="Podobne zdjęcia — grupa #" /><Run Text="{Binding ActiveSimilarityGroup.Id}" /></TextBlock>
                                <ItemsControl ItemsSource="{Binding ActiveSimilarityGroup.Photos}" Margin="0,10,0,12">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Width="48" Height="48" CornerRadius="5" ClipToBounds="True" Margin="0,0,5,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill" /></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource AccentButton}" Click="OpenCompare" MinHeight="34" Padding="10,6">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE89A;" Style="{StaticResource UiIcon}" Margin="0,0,8,0" /><TextBlock Text="Otwórz porównanie" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers><DataTrigger Binding="{Binding ActivePhoto}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="8,0,0,14"><TextBlock Text="Szczegóły" Style="{StaticResource PanelHeaderText}" /></Grid>
                                <Border Height="220" CornerRadius="6" Padding="4" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource TilePlaceholderBrush}">
                                    <Image Source="{Binding ActivePhoto.Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Margin="4,14,4,0">
                                    <TextBlock Text="{Binding ActivePhoto.FileName}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding ActivePhoto.FileName}" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Wykonano" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,12,10" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActivePhoto.DisplayDate, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" FontSize="11" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="Rozdzielczość" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,12,10" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" HorizontalAlignment="Right"><Run Text="{Binding ActivePhoto.Width}" /><Run Text=" × " /><Run Text="{Binding ActivePhoto.Height}" /></TextBlock>
                                        <TextBlock Grid.Row="2" Text="Rozmiar" Style="{StaticResource MutedText}" FontSize="11" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActivePhoto.SizeLabel}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="270" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <Grid Grid.Column="1" Margin="20,0" VerticalAlignment="Center" TextElement.FontSize="11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AnalysisStatus}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AnalysisStatus}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding AnalysisProgressText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding QueueAnalysisText}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ProgressBar Grid.Column="3" Height="4" Margin="12,0,0,0" Maximum="{Binding AnalysisTotal, Mode=OneWay}" Value="{Binding AnalyzedCount, Mode=OneWay}">
                            <ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding AnalysisTotal}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
                        </ProgressBar>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="30" MinHeight="30" BorderThickness="0" Background="Transparent" ToolTip="Mniejsze miniatury" Click="DecreaseThumbnailSize">&#xE738;</Button>
                        <Slider Width="130" Minimum="140" Maximum="280" Value="{Binding ThumbnailSize}" Margin="8,0" />
                        <Button Style="{StaticResource IconButton}" Width="30" MinHeight="30" BorderThickness="0" Background="Transparent" ToolTip="Większe miniatury" Click="IncreaseThumbnailSize">&#xE710;</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="QuickPreviewPopup" AllowsTransparency="True" Placement="Right" HorizontalOffset="12" StaysOpen="True" IsHitTestVisible="False">
                <Border Width="430" Style="{StaticResource CardBorder}" Padding="10">
                    <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.34" Color="{DynamicResource ShadowColor}" /></Border.Effect>
                    <StackPanel>
                        <Border Height="270" CornerRadius="7" ClipToBounds="True" Background="{DynamicResource TilePlaceholderBrush}"><Image x:Name="PreviewImage" Stretch="Uniform" /></Border>
                        <TextBlock Text="Szybki podgląd" Foreground="{DynamicResource MutedBrush}" Margin="2,10,0,2" />
                        <TextBlock x:Name="PreviewName" FontWeight="SemiBold" Margin="2,0" />
                        <TextBlock x:Name="PreviewMeta" Foreground="{DynamicResource MutedBrush}" Margin="2,5,0,2" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
